# ============================================================
# ENVIRONMENT: LOCAL CI-MIRROR MODE
# This file is used by run-ci-local.ps1 to replicate CI exactly.
# Firebase keys are loaded from .env.local — this file only
# contains the CI-specific overrides.
# ============================================================

# Force emulator mode (same as CI)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_USE_EMULATOR=true
NEXT_PUBLIC_IS_CI=true
NEXT_PUBLIC_E2E=true
ALLOW_E2E_SEED=true

# Emulator hosts (same ports as CI)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Project ID (must match emulator project)
FIREBASE_PROJECT_ID=dodo-beta
DO_FIREBASE_PROJECT_ID=dodo-beta
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dodo-beta

NODE_ENV=test

