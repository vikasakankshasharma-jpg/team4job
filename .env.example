# ==========================================
# B2B Dealer Network - Environment Variables
# ==========================================

# 1. Firebase Client Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# 2. Firebase Admin SDK (Secret - Server Only)
# Store the entire JSON string or individual values depending on your init strategy
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key\n-----END PRIVATE KEY-----\n"

# 3. Observability (Sentry)
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@o0.ingest.sentry.io/0"
SENTRY_AUTH_TOKEN="your-sentry-org-auth-token"

# 4. Payments (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 5. Application URL
NEXT_PUBLIC_APP_URL="https://team4job.com"
