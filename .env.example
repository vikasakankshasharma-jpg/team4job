# ============================================================
# ENVIRONMENT: LOCAL DEVELOPMENT
# Firebase Project: [YOUR PROJECT NAME]
# Emulators: ON (Auth :9099, Firestore :8080, Storage :9199)
# URL: http://localhost:3000
# ============================================================

# Firebase Config (Client)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# Firebase Admin (Server)
DO_FIREBASE_PROJECT_ID="your_project_id"
DO_FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com"
DO_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Cashfree Payments
CASHFREE_PAYMENTS_CLIENT_ID="your_cashfree_client_id"
CASHFREE_PAYMENTS_CLIENT_SECRET="your_cashfree_client_secret"
CASHFREE_CLIENT_ID="your_cashfree_client_id_2"
CASHFREE_CLIENT_SECRET="your_cashfree_client_secret_2"

# Tools
BREVO_API_KEY="your_brevo_api_key"
NEXT_PUBLIC_GA_ID="your_google_analytics_id"

# Sentry
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn"

# Gemini AI
GEMINI_API_KEY="your_gemini_api_key"

# Emulator Config (LOCAL DEV ONLY)
NEXT_PUBLIC_USE_EMULATOR=true
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_USE_FIRESTORE_EMULATOR=true

# Emulator Hosts (Required for Admin SDK)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
