{"type":"before","callId":"call@45","startTime":133542.554,"class":"Page","method":"addInitScript","params":{"source":"(() => {\n          const inject = () => {\n            if (!document.head) {\n              setTimeout(inject, 10);\n              return;\n            }\n            const style = document.createElement('style');\n            style.innerHTML = `\n                            .CookieConsent, \n                            #cookie-consent-banner, \n                            [class*=\"CookieConsent\"],\n                            [id*=\"cookie-consent\"],\n                            div[style*=\"z-index: 999\"] { \n                                display: none !important; \n                                visibility: hidden !important; \n                                pointer-events: none !important; \n                                opacity: 0 !important;\n                            }\n                        `;\n            document.head.appendChild(style);\n            // Also mock the cookie to prevent the library from even trying\n            document.cookie = \"dodo-cookie-consent=true; path=/\";\n          };\n          inject();\n        })(undefined)"},"stepId":"pw:api@51","pageId":"page@7408353509a6d8dd0f8e4c1c1806702f"}
