NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# Do NOT set FIREBASE_AUTH_EMULATOR_HOST here! 
# Playwright uses production Auth to avoid "invalid token signature" errors when the Admin SDK verifies the token.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
ALLOW_E2E_SEED=true
