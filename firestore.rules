rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        "Admin" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function isSupport() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ("Support Team" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles || isAdmin());
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---
    // Feature Flags - Readable by all authenticated users
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /feature_flags/{flagId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }


    // Confidential User Data (PII)
    match /users/{userId} {
      // PRODUCTION: Restrict user data access to authorized parties only
      allow read: if isOwner(userId) || isAdmin() || isSupport();
      
      // Strict Update Policy: Prevent Privilege Escalation
      // Users can ONLY update specific profile fields. 
      // THEY CANNOT UPDATE: roles, status, subscription, kycStatus, professionalProfile.verified, etc.
      allow update: if isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['name', 'avatarUrl', 'address', 'pincodes', 'about', 'portfolio', 'professionalProfile', 'fcmTokens', 'lastLoginAt', 'lastActiveAt', 'emergencyContacts']
        ) &&
        // If updating professionalProfile, ensure they aren't verifying themselves or changing ratings
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['professionalProfile']) || 
         (request.resource.data.professionalProfile.diff(resource.data.professionalProfile).affectedKeys().hasOnly(['skills', 'about']) || 
          isAdmin())
        );
        
      // Allow Admin to write anything
      allow write: if isAdmin();
      
      // --- SUBCOLLECTIONS ---
      
      // Job Drafts (e.g. users/123/jobDrafts/draft_456)
      match /jobDrafts/{draftId} {
        allow read, write: if isOwner(userId);
      }
      
      // Job Templates (Full Job)
      match /jobTemplates/{templateId} {
        allow read, write: if isOwner(userId);
      }
      
      // Budget Templates (Price Ranges)
      match /budgetTemplates/{templateId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public Profiles - Visible to everyone
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if false; // Only via Cloud Functions or Admin SDK
    }
    
    // Job Events Timeline - Mode 3 Architecture
    match /job_events/{eventId} {
      // Check if user is participant (Client, Awarded Pro, or Admin)
      function isJobParticipant(jobData) {
        return request.auth.uid == jobData.clientId 
          || request.auth.uid == jobData.awardedProfessionalId
          || (jobData.dealerId != null && request.auth.uid == jobData.dealerId)
          || isAdmin()
          || isSupport();
      }

      allow read: if request.auth != null && 
        isJobParticipant(get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data);
      
      // Strict immutability from client. Server uses Admin SDK to create these.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // --- DEALER WORKSPACE (PHASE 3 SECURITY) ---
    match /dealers/{dealerId} {
      allow read: if isOwner(dealerId) || isAdmin() || isSupport();
      // Server-side writes only for Dealer profile to prevent spoofing metrics
      allow write: if isAdmin(); 

      match /customers/{customerId} {
        allow read, write: if isOwner(dealerId) || isAdmin();
      }

      match /serviceSites/{siteId} {
        allow read: if isOwner(dealerId) || isAdmin();
        // Cannot spoof dealerId ownership
        allow create: if isOwner(dealerId) && request.resource.data.dealerId == dealerId;
        allow update: if isOwner(dealerId) 
                      && resource.data.dealerId == dealerId 
                      && request.resource.data.dealerId == dealerId; // Immutable ownership
        allow delete: if isAdmin();
      }

      match /operationalMemory/{installerId} {
        allow read, write: if isOwner(dealerId) || isAdmin();
      }
    }

    // Jobs - Core Logic Security
    match /jobs/{jobId} {
      function isJobParticipant(jobData) {
        return request.auth.uid == jobData.clientId 
          || request.auth.uid == jobData.awardedProfessionalId
          || (jobData.dealerId != null && request.auth.uid == jobData.dealerId)
          || isAdmin()
          || isSupport();
      }

      // Installer Isolation: Can only read if participant or job is open.
      // NOTE: To fully protect exact address and B2B pricing without relying ONLY on DTOs,
      // those fields should reside in the /private/details subcollection.
      allow read: if request.auth != null && 
        (isJobParticipant(resource.data) || resource.data.status in ['open', 'Open for Bidding']);
        
      allow create: if request.auth != null && 
        ("Client" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles || 
         "Dealer" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles) &&
        request.resource.data.clientId == request.auth.uid;
      
      // Strict Update Policy for Jobs: Prevent State-Machine Bypass & Financial Field Manipulation
      allow update: if request.auth != null && 
        (
          (resource.data.clientId == request.auth.uid &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'status', 'paymentStatus', 'awardedProfessionalId', 'awardedProfessional', 
             'winningBidAmount', 'escrowStatus', 'transactionId', 'disputeId', 'timeline',
             'dealerMargin', 'b2bPrice', 'b2bCost' // Financial isolation
           ])
          ) ||
          isAdmin() || 
          isSupport()
        );
      
      allow delete: if request.auth != null && 
        (resource.data.clientId == request.auth.uid || isAdmin());

      // --- PRIVATE JOB DETAILS (For exact address & dealer financials pre-award) ---
      match /private/{docId} {
        allow read: if request.auth != null && isJobParticipant(get(/databases/$(database)/documents/jobs/$(jobId)).data);
        allow write: if request.auth != null && (get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid || isAdmin());
      }

      // --- BIDS SUB-COLLECTION ---
      match /bids/{bidId} {
        allow read: if request.auth != null && (
          ('professionalId' in resource.data && resource.data.professionalId == request.auth.uid) || 
          get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid ||
          // Allow awarded professional to read all bids on their job (needed to calculate winningBidAmount)
          get(/databases/$(database)/documents/jobs/$(jobId)).data.awardedProfessionalId == request.auth.uid ||
          isAdmin() || 
          isSupport()
        );
        
        // Strict create: Prevent spoofing professionalId
        allow create: if request.auth != null && 
          "Professional" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles &&
          request.resource.data.professionalId == request.auth.uid &&
          get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId != request.auth.uid;
          
        // Strict update: Professional can't change professionalId
        allow update, delete: if isOwner(resource.data.professionalId) && 
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['professionalId'])) || 
          isAdmin();
      }
      
      // --- COMMUNICATIONS SUB-COLLECTION ---
      match /communications/{commId} {
        function isJobParticipant() {
          let jobData = get(/databases/$(database)/documents/jobs/$(jobId)).data;
          return request.auth.uid == jobData.clientId ||
                 request.auth.uid == jobData.awardedProfessionalId;
        }
        
        allow read: if request.auth != null && isJobParticipant();
        
        allow create: if request.auth != null && 
          isJobParticipant() &&
          request.resource.data.author == request.auth.uid &&
          request.resource.data.jobId == jobId;
        
        allow update, delete: if isAdmin();
      }

      // --- TIMELINE SUB-COLLECTION ---
      match /timeline/{eventId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/jobs/$(jobId)).data.awardedProfessionalId == request.auth.uid ||
          isAdmin() || 
          isSupport()
        );
        
        // Only created via Server Actions / Cloud Functions to ensure audit trail integrity
        allow create, update, delete: if isAdmin();
      }
    }

    // Transactions - Production Rules
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.payerId == request.auth.uid || resource.data.payeeId == request.auth.uid || isAdmin() || isSupport());
      
      // CRITICAL SECURITY: Transactions can NEVER be created or updated by clients.
      // Must go through Server Actions (Firebase Admin SDK bypasses these rules).
      allow create, update: if isAdmin();
        
      allow delete: if isAdmin();
    }

    // Disputes
    match /disputes/{disputeId} {
      allow read: if request.auth != null && 
        (resource.data.requesterId == request.auth.uid ||
         resource.data.parties.clientId == request.auth.uid || 
         resource.data.parties.professionalId == request.auth.uid || 
         isSupport());
      allow create: if request.auth != null && request.resource.data.requesterId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.requesterId == request.auth.uid || isSupport());
    }

    // FinOps Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Cloud Functions/Admin SDK
    }

    // Blacklist - Admin Only
    match /blacklist/{entry} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Subscription Plans - Admin Write, Public Read
    match /subscriptionPlans/{planId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Platform Settings - Admin Write, Public Read
    match /platform_settings/{setting} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    // Coupons - Admin Only
    match /coupons/{couponId} {
      allow read: if request.auth != null; // Users can read to validate coupons
      allow write: if isAdmin();
    }
    
    // Admin Alerts - Admin Only
    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Cloud Functions/Admin SDK
    }
    
    // Admin Action Logs - Admin Read, System Write
    match /admin_action_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Cloud Functions/Admin SDK
    }
    
    // Pending Signups - Admin Read/Write, System Write
    match /pending_signups/{mobile} {
      allow read: if isAdmin() || isSupport();
      // Basic validation to mitigate spam: Document ID must be 10-15 digits
      allow create: if request.auth == null && mobile.matches('^\\\\+?[0-9]{10,15}$'); 
      allow update: if isAdmin() || isSupport(); 
      allow delete: if isAdmin();
    }
    
    // Settings (not platform_settings) - readable by all authenticated users
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }


    // --- ACTIVITIES ---
    // User Activities - Readable by owner, Writable by owner (for client-side logging) or Admin
    match /activities/{activityId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- NOTIFICATIONS ---
    
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Admin/System creates notifications via SDK. We shouldn't allow clients to spoof notifications.
      allow create: if false; 
      
      allow update: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());

      allow delete: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notificationPreferences/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
      
      allow write: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
    }

    // --- CONVERSATIONS (Messaging) ---
    // Restrict access to participants only
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    // --- ADMIN & MISC COLLECTIONS ---
    match /cases/{caseId} {
      allow read, write: if isAdmin() || isSupport();
    }
    match /case_queue/{itemId} {
      allow read, write: if isAdmin() || isSupport();
    }
    match /financial_exceptions/{exceptionId} {
      allow read, write: if isAdmin() || isSupport();
    }
    match /approval_requests/{requestId} {
      allow read, write: if isAdmin() || isSupport();
    }
    match /reports/{reportId} {
      allow read, write: if isAdmin() || isSupport();
    }
    match /system_logs/{logId} {
      allow read, write: if isAdmin() || isSupport();
    }
    match /business_audit_logs/{logId} {
      allow read, write: if isAdmin() || isSupport();
    }
    match /saved_searches/{searchId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /userTemplates/{templateId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
